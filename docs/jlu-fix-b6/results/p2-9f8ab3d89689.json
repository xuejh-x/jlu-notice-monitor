        "sha256": "42e8ebe13c9ad5515f1f3a6675f740ab6417d669c67067152c80819ea04708d8",
        "html_path": "html/42e8ebe13c9ad5515f1f3a6675f740ab6417d669c67067152c80819ea04708d8.html",
        "replacement_chars": 0,
