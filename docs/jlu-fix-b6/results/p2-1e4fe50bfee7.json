        "sha256": "9c17e58d0185a93beda556560ebf84c2bf0610d70cb160fb64daa47e587de341",
        "html_path": "html/9c17e58d0185a93beda556560ebf84c2bf0610d70cb160fb64daa47e587de341.html",
        "replacement_chars": 0,
        "chars": 41700,
