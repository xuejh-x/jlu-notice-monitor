        "auth": false,
        "sha256": "20717fcbc5c298dace4b44ba05b24858ba17ef432a8995cf6cd3894d32a41e63",
        "html_path": "html/20717fcbc5c298dace4b44ba05b24858ba17ef432a8995cf6cd3894d32a41e63.html",
