    {
      "url": "https://const.jlu.edu.cn/info/1080/8503.htm",
      "list_title": "关于开展建设工程学院2026年优秀共产党员、优秀党务工作者、先进基层党组织评选表彰工作的通知",
      "list_date": "2026-05-15",
      "response": {
        "url": "https://const.jlu.edu.cn/info/1080/8503.htm",
        "time": "2026-10-15T19:42:48+08:00",
        "ok": true,
        "final_url": "https://const.jlu.edu.cn/info/1080/8503.htm",
