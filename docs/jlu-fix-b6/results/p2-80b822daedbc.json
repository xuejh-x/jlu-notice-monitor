        "auth": false,
        "sha256": "ca7e8af054c886764cfd82f56dd16fb7743bc527b1f6c82712898a3941b3a2c3",
        "html_path": "html/ca7e8af054c886764cfd82f56dd16fb7743bc527b1f6c82712898a3941b3a2c3.html",
