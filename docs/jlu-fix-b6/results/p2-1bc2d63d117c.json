        "auth": false,
        "sha256": "3ac14a6024d0132a94686d2fd5c1e39a309585471116090d2cacc120fc5489a8",
        "html_path": "html/3ac14a6024d0132a94686d2fd5c1e39a309585471116090d2cacc120fc5489a8.html",
        "replacement_chars": 0,
        "chars": 23128,
