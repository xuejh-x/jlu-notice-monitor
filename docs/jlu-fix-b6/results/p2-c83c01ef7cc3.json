        "status": 200,
        "auth": false,
        "sha256": "645c059f5fa91d40ef30aad116042ecf27f00df4a0111aa86376f845a6b2f347",
        "html_path": "html/645c059f5fa91d40ef30aad116042ecf27f00df4a0111aa86376f845a6b2f347.html",
        "replacement_chars": 0,
        "chars": 40875,
