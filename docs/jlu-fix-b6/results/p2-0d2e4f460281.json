      "url": "https://kgxy.jlu.edu.cn/info/1026/5719.htm",
      "list_title": "(转)关于组织申报2026年度吉林大学“人工智能+”虚拟仿真实验教学项目的通知",
      "list_date": "2026-10-13",
      "response": {
        "url": "https://kgxy.jlu.edu.cn/info/1026/5719.htm",
        "time": "2026-10-15T19:36:26+08:00",
        "ok": true,
        "final_url": "https://kgxy.jlu.edu.cn/info/1026/5719.htm",
