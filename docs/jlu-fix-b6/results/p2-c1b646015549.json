        "sha256": "a89cc244fc3878f27997314fd33ebe6eb4f4304a8192505ee7b5f878bb56f206",
        "html_path": "html/a89cc244fc3878f27997314fd33ebe6eb4f4304a8192505ee7b5f878bb56f206.html",
        "replacement_chars": 0,
        "chars": 33898,
