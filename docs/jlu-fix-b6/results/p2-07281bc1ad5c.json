      "list_date": "2025-12-01",
      "response": {
        "url": "https://dmse.jlu.edu.cn/info/1050/7504.htm",
        "time": "2026-10-15T19:41:08+08:00",
        "ok": true,
        "final_url": "https://dmse.jlu.edu.cn/info/1050/7504.htm",
