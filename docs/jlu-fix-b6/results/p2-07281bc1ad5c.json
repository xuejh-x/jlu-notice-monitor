        "auth": false,
        "sha256": "07a1b6e5143c2d723107b3848a46d26b08e0644fbeb20c0f6b4a12ee9b6e2bf2",
        "html_path": "html/07a1b6e5143c2d723107b3848a46d26b08e0644fbeb20c0f6b4a12ee9b6e2bf2.html",
        "replacement_chars": 0,
        "chars": 47954,
