      "list_title": "（转）关于发布吉林大学2026—2027学年赴国外高校校际交换学习项目的通知",
      "parsed_title": "（转）关于发布吉林大学2026—2027学年赴国外高校校际交换学习项目的通知",
      "document_title": "（转）关于发布吉林大学2026—2027学年赴国外高校校际交换学习项目的通知-吉林大学考古学院",
      "heading_texts": [],
