        "auth": false,
        "sha256": "9700c19b5e71cdd055299e1c6364ae23aacff6042dbf3c02858f4a7d28d067f9",
        "html_path": "html/9700c19b5e71cdd055299e1c6364ae23aacff6042dbf3c02858f4a7d28d067f9.html",
        "replacement_chars": 0,
        "chars": 41236,
