        "sha256": "b62755877148e11f74575a05ad8f515366a66e6bc23d91bc23bb29c2509889e0",
        "html_path": "html/b62755877148e11f74575a05ad8f515366a66e6bc23d91bc23bb29c2509889e0.html",
        "replacement_chars": 0,
        "chars": 15966,
