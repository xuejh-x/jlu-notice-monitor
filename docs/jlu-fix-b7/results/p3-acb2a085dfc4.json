    {
      "url": "http://icfs.jlu.edu.cn/info/1007/3738.htm",
      "list_title": "高压科学与技术团队在脉冲电势驱动铜表面非平衡重构模拟方面取得进展",
      "list_date": "2026-09-11",
      "response": {
        "url": "http://icfs.jlu.edu.cn/info/1007/3738.htm",
        "time": "2026-10-15T22:12:36+08:00",
        "ok": true,
        "final_url": "http://icfs.jlu.edu.cn/info/1007/3738.htm",
