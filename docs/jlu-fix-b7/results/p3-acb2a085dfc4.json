        "status": 200,
        "auth": false,
        "sha256": "3b2db38deb51d5640dea9cf1825bfb2bfe11e1b8e41bda7434dc451f14781772",
        "html_path": "html/3b2db38deb51d5640dea9cf1825bfb2bfe11e1b8e41bda7434dc451f14781772.html",
        "replacement_chars": 0,
