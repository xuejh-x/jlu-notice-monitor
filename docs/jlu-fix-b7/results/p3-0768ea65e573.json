        "status": 200,
        "auth": false,
        "sha256": "db4587f3be2f9dbd526af306fa9caa625648cfcd8ce09d0ab092e6115958575c",
        "html_path": "html/db4587f3be2f9dbd526af306fa9caa625648cfcd8ce09d0ab092e6115958575c.html",
        "replacement_chars": 0,
        "chars": 8756,
