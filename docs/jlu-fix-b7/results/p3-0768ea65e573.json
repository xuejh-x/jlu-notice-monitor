    {
      "url": "http://pathobiology.jlu.edu.cn/info/1020/1136.htm",
      "list_title": "基础医学院2门课程入选首批国家级一流本科课程",
      "list_date": "2020-12-18",
      "response": {
        "url": "http://pathobiology.jlu.edu.cn/info/1020/1136.htm",
