        "sha256": "003ceef20c51e5f4931cdf6aa502c2b1e405ef817ba71f0adf4527a0dcb22e78",
        "html_path": "html/003ceef20c51e5f4931cdf6aa502c2b1e405ef817ba71f0adf4527a0dcb22e78.html",
        "replacement_chars": 0,
        "chars": 22790,
