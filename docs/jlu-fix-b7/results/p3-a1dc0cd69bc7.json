        "sha256": "08f4f5536226a4e121af8f2fc2cdf66e2d20dd194d9365573960d905d73f01b5",
        "html_path": "html/08f4f5536226a4e121af8f2fc2cdf66e2d20dd194d9365573960d905d73f01b5.html",
        "replacement_chars": 0,
        "chars": 13443,
