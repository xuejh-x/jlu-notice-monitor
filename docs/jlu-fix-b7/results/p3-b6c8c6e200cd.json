        "sha256": "6ce3dcc4de7d7b2519ff7cacc8e8f316db653ac09d9eee12f28f6225a4d01a84",
        "html_path": "html/6ce3dcc4de7d7b2519ff7cacc8e8f316db653ac09d9eee12f28f6225a4d01a84.html",
        "replacement_chars": 0,
        "chars": 23800,
