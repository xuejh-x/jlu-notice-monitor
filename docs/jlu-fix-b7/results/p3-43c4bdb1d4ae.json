      "list_title": "关于2022年住院医师规范化/助理全科医生 培训结业考核有关事宜的通知",
      "list_date": "2022-06-28",
      "response": {
        "url": "https://ywc.jlu.edu.cn/info/1048/1864.htm",
        "time": "2026-10-15T22:10:43+08:00",
        "ok": true,
