    {
      "url": "http://sklio.jlu.edu.cn/info/1048/1725.htm",
      "list_title": "转发吉林省科学技术厅《关于征集2025年度国家自然科学基金区域创新发展联合基金项目指南建议的通知》",
      "list_date": "",
      "response": {
        "url": "http://sklio.jlu.edu.cn/info/1048/1725.htm",
