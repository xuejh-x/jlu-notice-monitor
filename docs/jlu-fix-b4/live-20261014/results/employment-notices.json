    {
      "url": "https://jdjyw.jlu.edu.cn/portal/jyzp/article/details?id=68323d13461144df9d6e101775d24078",
      "list_title": "吉林大学2027届毕业生秋季校园招聘邀请函",
      "list_date": "2026-07-20",
