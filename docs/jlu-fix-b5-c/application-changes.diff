+                path = PurePosixPath(unquote(target.path))
+                if path.suffix.lower() != ".pdf":
+                    continue
+            except ValueError:
+                continue
+            attachments.append(AttachmentData(filename=path.name, url=target.geturl(), type="pdf"))
+            if len(attachments) == 50:
+                return attachments
+    return attachments
+
