{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口仅可通过系统默认应用打开常规 URL",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-settings:notifications"
        }
      ]
    },
    "notification:default"
  ]
}
