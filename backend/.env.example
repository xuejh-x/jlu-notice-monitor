JLU_ENVIRONMENT=development
JLU_APP_DATA_DIR=
JLU_DATABASE_URL=
JLU_HOST=127.0.0.1
JLU_PORT=8000
JLU_LOG_LEVEL=INFO
JLU_REQUEST_TIMEOUT=20
JLU_MAX_ITEMS_PER_SECTION=30
JLU_BOOTSTRAP_RECENT_DAYS=7
JLU_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://tauri.localhost"]

# Gate 12 deployment roles: desktop imports official facts from the public feed;
# cloud crawls official sources and serves /api/public/v1; standalone is local development only.
JLU_DEPLOYMENT_ROLE=standalone
# Set on Desktop/cloud staging after the Gate 10D production soak is accepted.
# JLU_PUBLIC_FEED_URL=https://notice-hub.example/api/public/v1
JLU_OA_HEADLESS=true

# Gate 13 Cloud administration. Configure only on the Cloud host; never bundle a value.
NOTICE_HUB_ADMIN_KEY=
# Desktop target for administrator-triggered source promotion (HTTPS outside local fixtures).
NOTICE_HUB_CLOUD_ADMIN_URL=
